# Stats Service Configuration
# Copy this file to .env and fill in the values

# Host and port for the FastAPI service
STATS_SERVICE_HOST=0.0.0.0
STATS_SERVICE_PORT=8000

# CORS: comma-separated list of allowed origins for the Next.js frontend.
# In production, set this to your deployed frontend URL(s).
# Example: ALLOWED_ORIGINS=https://app.sportstower.com,https://staging.sportstower.com
# Default (when unset): http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# NBA API rate limiting: delay in seconds between nba_api requests
# NBA.com will block rapid requests; keep this at 2-3 seconds minimum
NBA_API_RATE_LIMIT_SECONDS=2.5

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
